# VentureOS — environment template
# Copy to .env.local and fill in. Never commit .env.local.

# --- Next.js app ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase CLI (schema + auth config from repo) ---
# Project ref: Supabase dashboard → Project Settings → General
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
# DB password (optional; avoids interactive prompt on link/db push)
SUPABASE_DB_PASSWORD=
# Personal access token for CI only — local dev uses `supabase login`
SUPABASE_ACCESS_TOKEN=

# --- Google OAuth (pushed to Supabase via supabase/config.toml) ---
# Create at: Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Cloud Console — add this Authorized redirect URI (not the app /auth/callback):
# https://YOUR-PROJECT-REF.supabase.co/auth/v1/callback
